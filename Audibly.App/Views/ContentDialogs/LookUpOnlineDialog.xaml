<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Next"
    SecondaryButtonClick="OnSecondaryButtonClick"
    Title="Look up online"
    x:Class="Audibly.App.Views.ContentDialogs.LookUpOnlineDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:Audibly.App.Views.ContentDialogs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="640" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  step 1: search  -->
        <Grid ColumnSpacing="8" x:Name="SearchBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="Title and author"
                x:Name="SearchBox" />
            <Button
                Click="Search_Click"
                Content="Search"
                Grid.Column="1" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                Height="20"
                IsActive="False"
                Width="20"
                x:Name="Busy" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                x:Name="StatusText" />
        </StackPanel>

        <ListView
            Grid.Row="2"
            MaxHeight="420"
            SelectionChanged="Hits_SelectionChanged"
            SelectionMode="Single"
            x:Name="HitList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HitItem">
                    <Grid
                        ColumnSpacing="12"
                        Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Height="48"
                            Source="{x:Bind Image}"
                            Stretch="UniformToFill"
                            VerticalAlignment="Top"
                            Width="48" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Details}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  step 2: choose the fields  -->
        <ScrollViewer
            Grid.Row="2"
            MaxHeight="420"
            Visibility="Collapsed"
            x:Name="FieldPanel">
            <ItemsControl x:Name="FieldList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:FieldItem">
                        <Grid
                            ColumnSpacing="12"
                            Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Content="{x:Bind Label}"
                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                IsEnabled="{x:Bind CanApply}"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="1"
                                MaxLines="3"
                                Text="{x:Bind Old}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind Old}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                MaxLines="3"
                                Text="{x:Bind New}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind New}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    mc:Ignorable="d"
    x:Class="Audibly.App.UserControls.NowPlayingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:Audibly.App.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <converters:ProgressSliderValueConverter x:Key="ProgressSliderValueConverter" />
    </UserControl.Resources>

    <!--  now playing bar  -->
    <Grid
        ColumnSpacing="15"
        HorizontalAlignment="Stretch"
        x:Name="NowPlayingBarGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            FontSize="20"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind PlayerViewModel.ProgressElapsedText, Mode=OneWay}"
            VerticalAlignment="Bottom"
            x:Name="CurrentTimeTextBlock" />

        <Slider
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,-4"
            Maximum="{x:Bind PlayerViewModel.ProgressMaximumMs, Mode=OneWay}"
            ValueChanged="Slider_OnValueChanged"
            ThumbToolTipValueConverter="{StaticResource ProgressSliderValueConverter}"
            Value="{x:Bind PlayerViewModel.ProgressValueMs, Mode=OneWay}"
            VerticalAlignment="Bottom"
            x:Name="ProgressSlider" />

        <!--  Tapping the end time switches between total, time remaining and percent.  -->
        <!--  A button, so it also works with the keyboard and assistive tools.  -->
        <Button
            AutomationProperties.AutomationId="ProgressEndButton"
            AutomationProperties.Name="Switch time display"
            Background="Transparent"
            BorderThickness="0"
            Click="EndTime_OnClick"
            Grid.Column="2"
            HorizontalAlignment="Center"
            MinHeight="0"
            MinWidth="0"
            Padding="0"
            ToolTipService.ToolTip="Click to switch between total, time remaining and percent"
            VerticalAlignment="Bottom">
            <TextBlock
                AutomationProperties.AutomationId="ProgressEndText"
                FontSize="20"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind PlayerViewModel.ProgressEndText, Mode=OneWay}"
                x:Name="RemainingTimeTextBlock" />
        </Button>

    </Grid>
</UserControl>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Audibly.Mobile.Views"
             x:Class="Audibly.Mobile.Views.LibraryPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
             Title="Library">

    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="RescanButton" Clicked="Rescan_Clicked" Text="Rescan" />
        <ToolbarItem AutomationId="FolderButton" Clicked="Folder_Clicked" Text="Folder" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <Label
            x:Name="StatusLabel"
            AutomationId="StatusLabel"
            FontSize="13"
            IsVisible="False"
            Margin="16,8"
            TextColor="{StaticResource Gray500}" />

        <!--  only on the very first opening; afterwards the list from last time shows at once  -->
        <ActivityIndicator
            x:Name="LoadingIndicator"
            Grid.Row="1"
            HorizontalOptions="Center"
            IsVisible="False"
            Margin="0,48,0,0"
            VerticalOptions="Start" />

        <!--  one card per book; tapping it opens the book in the player  -->
        <CollectionView
            x:Name="BookList"
            AutomationId="BookList"
            Grid.Row="1"
            Margin="10,4"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">
                    <Label FontSize="20" HorizontalTextAlignment="Center" Text="No audiobooks yet" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="Choose the folder on your phone that holds your audiobooks. A subfolder with several files is one book."
                        TextColor="{StaticResource Gray500}" />
                    <Button AutomationId="ChooseFolderButton" Clicked="Folder_Clicked" Text="Choose folder" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:BookItem">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="0"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Book_Tapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                            <Grid BackgroundColor="{StaticResource Gray200}" HeightRequest="120" WidthRequest="96">
                                <Label
                                    FontSize="34"
                                    HorizontalOptions="Center"
                                    Text="{Binding Initial}"
                                    TextColor="{StaticResource Gray500}"
                                    VerticalOptions="Center" />
                                <Image Aspect="AspectFill" Source="{Binding Cover}" />
                            </Grid>
                            <Grid Grid.Column="1" Padding="0,10,12,10" RowDefinitions="*,Auto" RowSpacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="{Binding TitleAttributes}"
                                            FontSize="18"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding Title}" />
                                        <Label
                                            FontSize="13"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Subtitle}"
                                            TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    <!--  the book that is open  -->
                                    <Ellipse
                                        Fill="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                        Grid.Column="1"
                                        HeightRequest="9"
                                        IsVisible="{Binding IsOpen}"
                                        Margin="8,6,0,0"
                                        VerticalOptions="Start"
                                        WidthRequest="9" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Grid.Row="1">
                                    <Label FontSize="14" Text="{Binding Length}" VerticalOptions="Center" />
                                    <ProgressBar Grid.Column="1" Progress="{Binding Progress}" VerticalOptions="Center" />
                                    <Label FontSize="14" Grid.Column="2" Text="{Binding Percent}" VerticalOptions="Center" />
                                    <!--  remove from the library, optionally with the files  -->
                                    <views:IconButton
                                        AutomationId="BookMenuButton"
                                        Clicked="BookMenu_Clicked"
                                        Data="{x:Static views:PlayerIcons.More}"
                                        Grid.Column="3"
                                        IconSize="18"
                                        Margin="-8,-10,-10,-10"
                                        SemanticProperties.Description="Book options" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Audibly.Mobile.Views"
             x:Class="Audibly.Mobile.Views.PlayerPage"
             Shell.NavBarIsVisible="False"
             Title="Player">

    <Grid>

        <!--  the player: quick links, book progress, cover, chapter progress, transport  -->
        <Grid x:Name="PlayerLayout" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="0">

            <!--  menu on the left, quick links on the right  -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="6,4">
                <views:IconButton AutomationId="MenuButton" Clicked="Menu_Clicked" Data="{x:Static views:PlayerIcons.Menu}" SemanticProperties.Description="Menu" />
                <Button
                    x:Name="SpeedButton"
                    AutomationId="SpeedButton"
                    BackgroundColor="Transparent"
                    Clicked="Speed_Clicked"
                    FontAttributes="Bold"
                    FontSize="20"
                    Grid.Column="2"
                    Padding="10,0"
                    SemanticProperties.Description="Playback speed"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Grid Grid.Column="3">
                    <views:IconButton x:Name="TimerIcon" AutomationId="TimerButton" Clicked="Timer_Clicked" Data="{x:Static views:PlayerIcons.Timer}" Outline="True" SemanticProperties.Description="Sleep timer" />
                    <Button
                        x:Name="TimerText"
                        AutomationId="TimerText"
                        BackgroundColor="Transparent"
                        Clicked="Timer_Clicked"
                        FontAttributes="Bold"
                        IsVisible="False"
                        Padding="6,0"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>
                <views:IconButton AutomationId="LibraryButton" Clicked="Library_Clicked" Data="{x:Static views:PlayerIcons.Library}" Grid.Column="4" SemanticProperties.Description="Library" />
            </Grid>

            <!--  the whole book: elapsed, percent, time remaining at the current speed  -->
            <VerticalStackLayout Grid.Row="1" Spacing="2">
                <ProgressBar x:Name="BookProgress" AutomationId="BookProgress" HeightRequest="5" />
                <Grid ColumnDefinitions="*,Auto,*" Padding="12,0">
                    <Label x:Name="BookElapsedLabel" AutomationId="BookElapsedLabel" FontAttributes="Bold" FontSize="17" />
                    <Label x:Name="BookPercentLabel" AutomationId="BookPercentLabel" FontAttributes="Bold" FontSize="17" Grid.Column="1" />
                    <Label x:Name="BookRemainingLabel" AutomationId="BookRemainingLabel" FontAttributes="Bold" FontSize="17" Grid.Column="2" HorizontalTextAlignment="End" />
                </Grid>
            </VerticalStackLayout>

            <!--  another device is further along: stays until the listener answers  -->
            <Border
                x:Name="OfferCard"
                AutomationId="OfferCard"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Grid.Row="2"
                IsVisible="False"
                Margin="12,8,12,0"
                Padding="14,12"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="OfferLabel" AutomationId="OfferLabel" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button AutomationId="OfferStayButton" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" BorderWidth="1" Clicked="OfferStay_Clicked" Text="Stay here" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Button AutomationId="OfferContinueButton" Clicked="OfferContinue_Clicked" Grid.Column="1" Text="Continue there" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  the cover fills what is left; without a cover the title stands in  -->
            <Grid Grid.Row="3" Margin="0,10">
                <VerticalStackLayout Padding="24" Spacing="6" VerticalOptions="Center">
                    <Label x:Name="TitleLabel" AutomationId="PlayerTitle" FontAttributes="Bold" FontSize="22" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="3" />
                    <Label x:Name="AuthorLabel" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Image x:Name="CoverImage" Aspect="AspectFit" />
            </Grid>

            <!--  the chapter: position, chapter number, time remaining at the current speed  -->
            <VerticalStackLayout Grid.Row="4" Padding="14,0" Spacing="0">
                <Slider x:Name="ProgressSlider" AutomationId="ProgressSlider" DragCompleted="Slider_DragCompleted" DragStarted="Slider_DragStarted" Maximum="1" Minimum="0" />
                <Grid ColumnDefinitions="*,Auto,*" Padding="10,0">
                    <Label x:Name="ChapterElapsedLabel" AutomationId="ChapterElapsedLabel" FontSize="15" TextColor="{StaticResource Gray500}" />
                    <Label x:Name="ChapterNumberLabel" AutomationId="ChapterNumberLabel" FontSize="15" Grid.Column="1" TextColor="{StaticResource Gray500}" />
                    <Label x:Name="ChapterRemainingLabel" AutomationId="ChapterRemainingLabel" FontSize="15" Grid.Column="2" HorizontalTextAlignment="End" TextColor="{StaticResource Gray500}" />
                </Grid>
            </VerticalStackLayout>

            <!--  chapter back, chapter name (tap for the list), chapter forward  -->
            <Grid ColumnDefinitions="Auto,*,Auto" Grid.Row="5" Padding="10,4">
                <views:IconButton AutomationId="PreviousChapterButton" Clicked="PreviousChapter_Clicked" Data="{x:Static views:PlayerIcons.PreviousChapter}" SemanticProperties.Description="Previous chapter" />
                <Button
                    x:Name="ChapterButton"
                    AutomationId="ChapterButton"
                    BackgroundColor="Transparent"
                    Clicked="Chapter_Clicked"
                    FontSize="17"
                    Grid.Column="1"
                    LineBreakMode="TailTruncation"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <views:IconButton AutomationId="NextChapterButton" Clicked="NextChapter_Clicked" Data="{x:Static views:PlayerIcons.NextChapter}" Grid.Column="2" SemanticProperties.Description="Next chapter" />
            </Grid>

            <!--  long jump back, short jump back, play or pause, short jump forward, long jump forward  -->
            <Grid ColumnDefinitions="*,*,Auto,*,*" Grid.Row="6" Padding="10,6,10,18">
                <views:IconButton AutomationId="BackFarButton" Clicked="BackFar_Clicked" Data="{x:Static views:PlayerIcons.RewindFar}" SemanticProperties.Description="Back 60 seconds" />
                <views:IconButton AutomationId="BackButton" Clicked="Back_Clicked" Data="{x:Static views:PlayerIcons.Rewind}" Grid.Column="1" SemanticProperties.Description="Back 10 seconds" />
                <Border
                    x:Name="PlayPauseButton"
                    AutomationId="PlayPauseButton"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Grid.Column="2"
                    HeightRequest="88"
                    Margin="8,0"
                    SemanticProperties.Description="Play"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    WidthRequest="88">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PlayPause_Clicked" />
                    </Border.GestureRecognizers>
                    <Path
                        x:Name="PlayPauseIcon"
                        Aspect="Uniform"
                        Fill="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                        HeightRequest="36"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="36" />
                </Border>
                <views:IconButton AutomationId="ForwardButton" Clicked="Forward_Clicked" Data="{x:Static views:PlayerIcons.Forward}" Grid.Column="3" SemanticProperties.Description="Forward 30 seconds" />
                <views:IconButton AutomationId="ForwardFarButton" Clicked="ForwardFar_Clicked" Data="{x:Static views:PlayerIcons.ForwardFar}" Grid.Column="4" SemanticProperties.Description="Forward 60 seconds" />
            </Grid>
        </Grid>

        <!--  nothing is open yet  -->
        <VerticalStackLayout x:Name="EmptyLayout" IsVisible="False" Padding="32" Spacing="16" VerticalOptions="Center">
            <Label FontSize="20" HorizontalTextAlignment="Center" Text="No audiobook open" />
            <Label HorizontalTextAlignment="Center" Text="Choose one from your library." TextColor="{StaticResource Gray500}" />
            <Button AutomationId="OpenLibraryButton" Clicked="Library_Clicked" Text="Open library" />
        </VerticalStackLayout>

        <!--  playback speed: fine steps, a slider, quick picks and the default for new books  -->
        <Grid x:Name="SpeedOverlay" AutomationId="SpeedOverlay" IsVisible="False">
            <BoxView BackgroundColor="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SpeedClose_Tapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Margin="20"
                Padding="18"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label FontSize="20" Text="Speed" VerticalOptions="Center" />
                        <Label x:Name="SpeedValueLabel" AutomationId="SpeedValueLabel" FontAttributes="Bold" FontSize="22" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button AutomationId="SpeedMinusButton" Clicked="SpeedMinus_Clicked" CornerRadius="22" FontSize="22" HeightRequest="44" Padding="0" SemanticProperties.Description="Slower" Text="−" WidthRequest="44" />
                        <Slider x:Name="SpeedSlider" AutomationId="SpeedSlider" Grid.Column="1" Minimum="0" ValueChanged="SpeedSlider_ValueChanged" VerticalOptions="Center" />
                        <Button AutomationId="SpeedPlusButton" Clicked="SpeedPlus_Clicked" CornerRadius="22" FontSize="22" Grid.Column="2" HeightRequest="44" Padding="0" SemanticProperties.Description="Faster" Text="+" WidthRequest="44" />
                    </Grid>
                    <HorizontalStackLayout x:Name="SpeedPicks" HorizontalOptions="Center" Spacing="2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Use as default for new audiobooks" VerticalOptions="Center" />
                        <CheckBox x:Name="SpeedDefaultCheck" AutomationId="SpeedDefaultCheck" CheckedChanged="SpeedDefault_Changed" Grid.Column="1" />
                    </Grid>
                    <Button AutomationId="SpeedDoneButton" Clicked="SpeedClose_Tapped" Text="Done" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>

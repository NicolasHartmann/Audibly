<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Audibly.Mobile.Views.PlayerPage"
             Title="Now playing">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="14">

            <!--  another device is further along: stays until the listener answers  -->
            <Border
                x:Name="OfferCard"
                AutomationId="OfferCard"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                IsVisible="False"
                Padding="14,12"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="OfferLabel" AutomationId="OfferLabel" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button AutomationId="OfferStayButton" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" BorderWidth="1" Clicked="OfferStay_Clicked" Text="Stay here" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Button AutomationId="OfferContinueButton" Clicked="OfferContinue_Clicked" Grid.Column="1" Text="Continue there" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                BackgroundColor="{StaticResource Gray100}"
                HeightRequest="280"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                WidthRequest="280">
                <Image x:Name="CoverImage" Aspect="AspectFill" />
            </Border>

            <Label
                x:Name="TitleLabel"
                AutomationId="PlayerTitle"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="2" />
            <Label
                x:Name="AuthorLabel"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource Gray500}" />

            <Button
                x:Name="ChapterButton"
                AutomationId="ChapterButton"
                BackgroundColor="Transparent"
                Clicked="Chapter_Clicked"
                LineBreakMode="TailTruncation"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            <Slider
                x:Name="ProgressSlider"
                AutomationId="ProgressSlider"
                DragCompleted="Slider_DragCompleted"
                DragStarted="Slider_DragStarted"
                Maximum="1"
                Minimum="0" />
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    x:Name="ElapsedLabel"
                    AutomationId="ElapsedLabel"
                    VerticalOptions="Center" />
                <!--  tapping the end time switches between total, time remaining and percent  -->
                <Button
                    x:Name="EndButton"
                    AutomationId="EndButton"
                    BackgroundColor="Transparent"
                    Clicked="End_Clicked"
                    Grid.Column="1"
                    Padding="0"
                    SemanticProperties.Description="Switch time display"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </Grid>

            <Grid ColumnDefinitions="*,*,Auto,*,*" ColumnSpacing="6">
                <Button AutomationId="PreviousChapterButton" Clicked="PreviousChapter_Clicked" SemanticProperties.Description="Previous chapter" Text="|◀" VerticalOptions="Center" />
                <Button AutomationId="BackButton" Clicked="Back_Clicked" Grid.Column="1" SemanticProperties.Description="Back 10 seconds" Text="−10" VerticalOptions="Center" />
                <!--  the main control: a large round button with the play or pause symbol  -->
                <Border
                    x:Name="PlayPauseButton"
                    AutomationId="PlayPauseButton"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Grid.Column="2"
                    HeightRequest="84"
                    Margin="8,0"
                    SemanticProperties.Description="Play"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    WidthRequest="84">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PlayPause_Clicked" />
                    </Border.GestureRecognizers>
                    <Path
                        x:Name="PlayPauseIcon"
                        Aspect="Uniform"
                        Fill="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                        HeightRequest="34"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="34" />
                </Border>
                <Button AutomationId="ForwardButton" Clicked="Forward_Clicked" Grid.Column="3" SemanticProperties.Description="Forward 30 seconds" Text="+30" VerticalOptions="Center" />
                <Button AutomationId="NextChapterButton" Clicked="NextChapter_Clicked" Grid.Column="4" SemanticProperties.Description="Next chapter" Text="▶|" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button x:Name="SpeedButton" AutomationId="SpeedButton" Clicked="Speed_Clicked" />
                <Button x:Name="TimerButton" AutomationId="TimerButton" Clicked="Timer_Clicked" Grid.Column="1" Text="Sleep timer" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Audibly.Mobile.Views.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="20">

            <VerticalStackLayout Spacing="6">
                <Label FontAttributes="Bold" Text="Audiobook folder" />
                <Label x:Name="FolderLabel" AutomationId="FolderLabel" TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label FontAttributes="Bold" Text="Sync" />
                <Label Text="Continue on another device and count listening time across devices. Choose a folder that a cloud app such as Google Drive or OneDrive keeps in sync on all your devices." TextColor="{StaticResource Gray500}" />
                <Label x:Name="SyncFolderLabel" AutomationId="SyncFolderLabel" />
                <Label x:Name="SyncStatusLabel" AutomationId="SyncStatusLabel" TextColor="{StaticResource Gray500}" />
                <Label x:Name="SyncDevicesLabel" AutomationId="SyncDevicesLabel" TextColor="{StaticResource Gray500}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button AutomationId="SyncChooseButton" Clicked="SyncChoose_Clicked" Text="Choose sync folder" />
                    <Button x:Name="SyncOffButton" AutomationId="SyncOffButton" Clicked="SyncOff_Clicked" Grid.Column="1" Text="Turn off" />
                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

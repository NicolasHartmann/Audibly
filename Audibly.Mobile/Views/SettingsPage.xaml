<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Audibly.Mobile.Views.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="20">

            <VerticalStackLayout Spacing="6">
                <Label FontAttributes="Bold" Text="Audiobook folder" />
                <Label x:Name="FolderLabel" AutomationId="FolderLabel" TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label FontAttributes="Bold" Text="Progress bar" />
                <Label Text="The part of the audiobook the progress bar covers" TextColor="{StaticResource Gray500}" />
                <RadioButton x:Name="ScopeChapter" AutomationId="ScopeChapter" CheckedChanged="Scope_Changed" Content="Chapter" GroupName="Scope" />
                <RadioButton x:Name="ScopeBook" AutomationId="ScopeBook" CheckedChanged="Scope_Changed" Content="Full title" GroupName="Scope" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label FontAttributes="Bold" Text="Time display" />
                <Label Text="Shown at the end of the progress bar. Time remaining takes the playback speed into account." TextColor="{StaticResource Gray500}" />
                <RadioButton x:Name="DisplayTotal" AutomationId="DisplayTotal" CheckedChanged="Display_Changed" Content="Elapsed and total" GroupName="Display" />
                <RadioButton x:Name="DisplayRemaining" AutomationId="DisplayRemaining" CheckedChanged="Display_Changed" Content="Time remaining" GroupName="Display" />
                <RadioButton x:Name="DisplayPercent" AutomationId="DisplayPercent" CheckedChanged="Display_Changed" Content="Percent" GroupName="Display" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

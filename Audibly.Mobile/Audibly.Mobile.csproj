<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Audibly for Android. Built with the .NET 10 SDK and the maui-android workload; it is not part of
	  Audibly.sln, which keeps building with the .NET 8 SDK. See Audibly.Mobile.sln.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Audibly.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Audibly</ApplicationTitle>
		<ApplicationId>app.audibly.mobile</ApplicationId>
		<ApplicationDisplayVersion>0.2</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<!-- Android 8: the oldest version with notification channels, which the playback service needs -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#005A9E" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#005A9E" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.1.0.4" />
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.11.1" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.11.1" />
		<!-- Media3 pulls AndroidX Core 1.19, which contains the classes of the older Core.Ktx that MAUI
		     references; the matching Core.Ktx is an empty shell and removes the duplicate classes. -->
		<PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Audibly.Core\Audibly.Core.csproj" />
		<ProjectReference Include="..\Audibly.Models\Audibly.Models.csproj" />
		<ProjectReference Include="..\Audibly.Repository\Audibly.Repository.csproj" />
		<ProjectReference Include="..\Audibly.Stats\Audibly.Stats.csproj" />
	</ItemGroup>

</Project>

<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Audibly.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Audibly.Mobile.Views"
    FlyoutBehavior="Flyout"
    Title="Audibly">

    <!--  the menu behind the player's burger button  -->
    <Shell.FlyoutHeader>
        <Label FontAttributes="Bold" FontSize="22" Padding="24,28,24,12" Text="Audibly" />
    </Shell.FlyoutHeader>

    <!--  the player is the only top-level page; everything else opens on top of it  -->
    <ShellContent
        ContentTemplate="{DataTemplate views:PlayerPage}"
        FlyoutItemIsVisible="False"
        Route="PlayerPage"
        Title="Player" />

    <MenuItem AutomationId="MenuPlayer" Clicked="Player_Clicked" Text="Player" />
    <MenuItem AutomationId="MenuLibrary" Clicked="Library_Clicked" Text="Library" />
    <MenuItem AutomationId="MenuSpeed" Clicked="Speed_Clicked" Text="Speed" />
    <MenuItem AutomationId="MenuTimer" Clicked="Timer_Clicked" Text="Sleep timer" />
    <MenuItem AutomationId="MenuSettings" Clicked="Settings_Clicked" Text="Settings" />

</Shell>
